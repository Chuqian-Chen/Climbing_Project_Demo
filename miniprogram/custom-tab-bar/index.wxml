<view class="tb">
  <view
    wx:for="{{items}}"
    wx:key="index"
    class="tb-item {{item.type === 'publish' ? 'tb-pub-wrap' : ''}}"
    data-item="{{item}}"
    bindtap="onItem"
  >
    <block wx:if="{{item.type === 'publish'}}">
      <view class="tb-pub">＋</view>
      <view class="tb-pub-text">发布</view>
    </block>
    <block wx:else>
      <image class="tb-icon {{active === item.index ? 'on' : ''}}" src="{{active === item.index ? item.iconOn : item.icon}}" mode="aspectFit" />
      <view class="tb-text {{active === item.index ? 'on' : ''}}">{{item.text}}</view>
    </block>
  </view>
</view>
