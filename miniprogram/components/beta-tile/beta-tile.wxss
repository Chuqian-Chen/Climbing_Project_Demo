.bt {
  background: #ffffff;
  border-radius: var(--r-md);
  overflow: hidden;
  margin-bottom: 16rpx;
}
.bt-hover {
  opacity: 0.92;
}

.bt-cover {
  position: relative;
  width: 100%;
  /* 封面高度自适应，封顶防超长图 */
  max-height: 520rpx;
  overflow: hidden;
}
.bt-img {
  width: 100%;
  display: block;
}
.bt-cover-dot {
  position: absolute;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  border: 3rpx solid #ffffff;
  transform: translate(-50%, -50%);
  box-shadow: 0 0 8rpx rgba(0, 0, 0, 0.35);
}
.bt-dur {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: var(--fs-xs);
  padding: 4rpx 12rpx;
  border-radius: var(--r-xs);
}
.bt-fit {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  background: var(--brand);
  color: #fff;
  font-size: var(--fs-xs);
  padding: 4rpx 12rpx;
  border-radius: var(--r-xs);
}
/* 右上角难度圆徽章（与墙面图上的线路徽章同款语言） */
.bt-corner {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  min-width: 56rpx;
  height: 56rpx;
  padding: 0 8rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  color: #fff;
  font-size: var(--fs-sm);
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.25);
  box-sizing: border-box;
}

.bt-cover-fb {
  height: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.bt-fb-grade {
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1;
}
.bt-fb-name {
  font-size: var(--fs-sm);
  color: var(--ink-2);
  margin-top: 10rpx;
  max-width: 90%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bt-body {
  padding: 16rpx 20rpx 18rpx;
}
.bt-title {
  font-size: var(--fs-base);
  font-weight: 600;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.bt-caution {
  font-size: var(--fs-xs);
  color: var(--red);
  background: var(--red-soft);
  border-radius: var(--r-xs);
  padding: 6rpx 12rpx;
  margin-top: 10rpx;
  /* 单行截断：-webkit-line-clamp 配合 padding 会把第二行露在内边距里 */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.bt-route {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}
.bt-dot {
  width: 18rpx;
  height: 18rpx;
  flex-shrink: 0;
}
.bt-route-name {
  font-size: var(--fs-sm);
  color: var(--ink-3);
  margin: 0 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 200rpx;
}
.bt-grade {
  font-size: var(--fs-sm);
  font-weight: 700;
}
.bt-foot {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}
.bt-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.bt-avatar-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sm);
}
.bt-nick {
  font-size: var(--fs-sm);
  color: var(--ink-3);
  margin-left: 10rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 160rpx;
}
.bt-local {
  font-size: var(--fs-xs);
  color: #2f7a58;
  border: 1rpx solid #bcdccb;
  border-radius: var(--r-xs);
  padding: 0 8rpx;
  margin-left: 10rpx;
  flex-shrink: 0;
}
.bt-like {
  font-size: var(--fs-sm);
  color: var(--ink-3);
  padding: 4rpx 0 4rpx 12rpx;
}
.bt-liked {
  color: var(--red);
}
