.es {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}
.es-icon {
  font-size: 88rpx;
  margin-bottom: 20rpx;
}
.es-title {
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--ink-2);
}
.es-desc {
  font-size: var(--fs-md);
  color: var(--ink-3);
  margin-top: 8rpx;
  text-align: center;
}
.es-btn {
  margin-top: 28rpx;
  padding: 14rpx 48rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: var(--fs-body);
  font-weight: 600;
}
