<view class="rc card {{open ? 'open' : ''}}" wx:if="{{route}}" bindtap="onTap" hover-class="rc-hover">
  <view class="row">
    <view class="rc-thumb-wrap" wx:if="{{route.visual}}">
      <image class="rc-thumb" src="{{route.visual.src}}" mode="aspectFill" lazy-load />
      <view
        wx:if="{{route.visual.wall}}"
        class="rc-thumb-dot"
        style="left:{{route.visual.x}}%;top:{{route.visual.y}}%;background:{{route.colorHex}}"
      ></view>
    </view>
    <view class="flex-1 rc-body">
      <view class="row">
        <view class="hold-dot {{route.colorLight ? 'light' : ''}}" style="background:{{route.colorHex}}"></view>
        <view class="rc-name ellipsis">{{route.name}}</view>
        <view class="badge-new" wx:if="{{route.isNew}}">新</view>
        <view class="badge-warn" wx:if="{{route.removingSoon}}">{{route.daysLeft === 0 ? '今日拆' : route.daysLeft + '天拆'}}</view>
        <view class="flex-1"></view>
        <view class="grade-badge" style="background:{{route.gradeColor}}">{{route.grade}}</view>
      </view>
      <view class="row rc-meta">
        <text class="faint small ellipsis">{{route.wallName || ''}}{{route.sendsTotal ? (route.wallName ? ' · ' : '') + route.sendsTotal + ' 人完攀' : ''}}</text>
        <view class="flex-1"></view>
        <view class="rc-beta {{open ? 'on' : ''}}" wx:if="{{previewable}}" catchtap="onPreview">{{open ? '收起' : ((route.betaCount || 0) + ' 条Beta')}}</view>
        <text class="faint small" wx:elif="{{route.betaCount}}">{{route.betaCount}} 条Beta</text>
      </view>
    </view>
  </view>
</view>
