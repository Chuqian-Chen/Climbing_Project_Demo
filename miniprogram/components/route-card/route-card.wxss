.rc {
  margin-bottom: 20rpx;
}
.rc-hover {
  transform: scale(0.985);
  transition: transform 0.1s;
}
.rc-name {
  font-size: 30rpx;
  font-weight: 700;
  margin: 0 12rpx;
  max-width: 300rpx;
}
.badge-new,
.badge-warn {
  margin-right: 10rpx;
}
.rc-thumb-wrap {
  position: relative;
  width: 110rpx;
  height: 110rpx;
  border-radius: 14rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 18rpx;
  background: #f0f2f5;
}
.rc-thumb {
  width: 100%;
  height: 100%;
}
.rc-thumb-dot {
  position: absolute;
  transform: translate(-50%, -50%);
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 4rpx solid #ffde59;
  box-shadow: 0 0 6rpx rgba(0, 0, 0, 0.4);
}
.rc-body {
  min-width: 0;
}
.rc-meta {
  margin-top: 10rpx;
  padding-left: 40rpx;
}
.rc-beta {
  color: #e8571f;
}
