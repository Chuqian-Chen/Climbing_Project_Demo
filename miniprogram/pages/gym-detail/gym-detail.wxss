.hero {
  padding: 40rpx 32rpx 36rpx;
  color: #fff;
}
.hero-name {
  font-size: 44rpx;
  font-weight: 800;
}
.hero-meta {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 10rpx;
}
.hero-tags {
  margin-top: 18rpx;
}
.hero-tag {
  display: inline-block;
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.22);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
}
.body {
  margin-top: -20rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: #f5f6f8;
  position: relative;
  padding-bottom: 48rpx;
}
.notice {
  font-size: 24rpx;
  color: #5a6072;
  background: #fffdf5;
  border: 2rpx solid #f5ecd0;
}
.lb-title {
  margin-bottom: 16rpx;
}
.lb-item {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}
.lb-rank {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f0f2f5;
  color: #5a6072;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}
.lb-rank.r1 { background: #ffe9b3; color: #8a6a2f; }
.lb-rank.r2 { background: #e8eaee; color: #5a6072; }
.lb-rank.r3 { background: #ffe0cc; color: #a05a2f; }
.lb-avatar {
  width: 56rpx;
  height: 56rpx;
  font-size: 30rpx;
  margin-right: 14rpx;
}
.lb-nick {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
}
.lb-sends {
  font-size: 24rpx;
  color: #e8571f;
  font-weight: 700;
}

.gs-card {
  padding: 18rpx 24rpx;
}
.gs-scroll {
  white-space: nowrap;
  margin-top: 12rpx;
}
.gs-chip {
  display: inline-flex;
  align-items: center;
  background: #f7f8fa;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  margin-right: 12rpx;
}
.gs-grade {
  font-size: 24rpx;
  font-weight: 700;
  margin-left: 10rpx;
}

.wp-scroll {
  white-space: nowrap;
}
.wp-item {
  display: inline-block;
  width: 200rpx;
  margin-right: 16rpx;
  vertical-align: top;
}
.wp-thumb {
  width: 200rpx;
  height: 150rpx;
  border-radius: 14rpx;
  background: #f0f2f5;
}
.wp-add {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9aa1b2;
  font-size: 48rpx;
}
.wp-name {
  font-weight: 600;
  margin-top: 8rpx;
}

.walls {
  white-space: nowrap;
  margin-bottom: 16rpx;
}
.wall-chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #5a6072;
  font-size: 24rpx;
  margin-right: 14rpx;
}
.wall-chip.on {
  background: #1b1e28;
  color: #fff;
  font-weight: 700;
}

.filters {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}
.f-chip {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #5a6072;
  font-size: 22rpx;
  margin: 0 12rpx 14rpx 0;
}
.f-chip.on {
  background: #fff1ea;
  color: #e8571f;
  font-weight: 700;
}
.f-chip.sort {
  margin-left: auto;
  background: transparent;
  color: #9aa1b2;
}

/* 分级标准众包编辑 */
.eg-edit-link {
  color: #e8571f;
}
.eg-opts {
  margin: 16rpx 0 4rpx;
}
.eg-chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #f0f2f5;
  color: #5a6072;
  font-size: 22rpx;
  margin: 0 12rpx 14rpx 0;
}
.eg-chip.on {
  background: #fff1ea;
  color: #e8571f;
  font-weight: 700;
}
.eg-ta {
  width: 100%;
  box-sizing: border-box;
  min-height: 180rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 16rpx;
  font-size: 26rpx;
  margin-bottom: 14rpx;
}
.eg-note {
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 14rpx 16rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}
.eg-actions {
  gap: 16rpx;
}

/* 线路卡展开区：该线的 Beta 预览（手风琴） */
.rb-panel {
  background: #ffffff;
  border-radius: 0 0 16rpx 16rpx;
  margin: -14rpx 0 16rpx;
  padding: 8rpx 24rpx 18rpx;
  border-top: 1rpx solid #f0f2f5;
}
.rb-loading,
.rb-empty {
  padding: 20rpx 0;
  text-align: center;
}
.rb-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f7f8fa;
}
.rb-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.rb-avatar-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.rb-mid {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
}
.rb-title {
  font-size: 27rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.rb-sub {
  margin-top: 4rpx;
}
.rb-caution {
  color: #e5484d;
  background: #fff3f3;
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
  margin-top: 8rpx;
  display: inline-block;
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  box-sizing: border-box;
}
.rb-likes {
  flex-shrink: 0;
  margin-top: 6rpx;
}
.rb-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}
.rb-act {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 14rpx 0;
  border-radius: 999rpx;
  background: #f2f3f7;
  color: #5a6072;
}
.rb-pub {
  background: #ff6b35;
  color: #fff;
  font-weight: 600;
}
