.hero {
  padding: 48rpx 32rpx 40rpx;
  color: #fff;
}
.hero-name {
  font-size: 44rpx;
  font-weight: 800;
}
.hero-meta {
  font-size: var(--fs-md);
  opacity: 0.85;
  margin-top: 10rpx;
}
.hero-tags {
  margin-top: 18rpx;
}
.hero-tag {
  display: inline-block;
  font-size: var(--fs-xs);
  background: rgba(255, 255, 255, 0.22);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
}
.body {
  margin-top: -20rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: var(--bg);
  position: relative;
  padding-bottom: 48rpx;
}
.notice {
  font-size: var(--fs-md);
  color: var(--ink-2);
  background: #fffdf5;
  border: 2rpx solid #f5ecd0;
}
.lb-title {
  margin-bottom: 16rpx;
}
.lb-item {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}
.lb-rank {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--chip);
  color: var(--ink-2);
  font-size: var(--fs-md);
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}
.lb-rank.r1 { background: #ffe9b3; color: #8a6a2f; }
.lb-rank.r2 { background: #e8eaee; color: var(--ink-2); }
.lb-rank.r3 { background: #ffe0cc; color: #a05a2f; }
.lb-avatar {
  width: 56rpx;
  height: 56rpx;
  font-size: var(--fs-lg);
  margin-right: 14rpx;
}
.lb-nick {
  flex: 1;
  font-size: var(--fs-body);
  font-weight: 600;
}
.lb-sends {
  font-size: var(--fs-md);
  color: var(--brand-deep);
  font-weight: 700;
}

.gs-row {
  margin-top: 20rpx;
}
.gs-chip {
  display: flex;
  align-items: center;
  background: var(--sunken);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  margin: 0 14rpx 14rpx 0;
}
.gs-grade {
  font-size: var(--fs-md);
  font-weight: 700;
  margin-left: 10rpx;
}

.wp-scroll {
  white-space: nowrap;
}
.wp-item {
  display: inline-block;
  width: 200rpx;
  margin-right: 16rpx;
  vertical-align: top;
}
.wp-thumb {
  width: 200rpx;
  height: 150rpx;
  border-radius: var(--r-md);
  background: var(--chip);
}
.wp-add {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-3);
  font-size: 48rpx;
}
.wp-name {
  font-weight: 600;
  margin-top: 8rpx;
}

.walls {
  white-space: nowrap;
  margin-bottom: 16rpx;
}
.wall-chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--ink-2);
  font-size: var(--fs-md);
  margin-right: 14rpx;
}
.wall-chip.on {
  background: var(--ink);
  color: #fff;
  font-weight: 700;
}

.filters {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}
.f-chip {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--ink-2);
  font-size: var(--fs-sm);
  margin: 0 12rpx 14rpx 0;
}
.f-chip.on {
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-weight: 700;
}
.f-chip.sort {
  margin-left: auto;
  background: transparent;
  color: var(--ink-3);
}

/* 分级标准众包编辑 */
.eg-edit-link {
  color: var(--brand-deep);
  margin-top: 12rpx;
}
.eg-opts {
  margin: 16rpx 0 4rpx;
}
.eg-chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--chip);
  color: var(--ink-2);
  font-size: var(--fs-sm);
  margin: 0 12rpx 14rpx 0;
}
.eg-chip.on {
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-weight: 700;
}
.eg-ta {
  width: 100%;
  box-sizing: border-box;
  min-height: 180rpx;
  background: var(--sunken);
  border-radius: var(--r-md);
  padding: 16rpx;
  font-size: var(--fs-body);
  margin-bottom: 14rpx;
}
.eg-note {
  background: var(--sunken);
  border-radius: var(--r-md);
  padding: 14rpx 16rpx;
  font-size: var(--fs-body);
  margin-bottom: 16rpx;
}
.eg-actions {
  gap: 16rpx;
}

/* 线路卡展开区：该线的 Beta 预览（手风琴） */
.rb-panel {
  background: #ffffff;
  border-radius: 0 0 16rpx 16rpx;
  margin: -14rpx 0 16rpx;
  padding: 8rpx 24rpx 18rpx;
  border-top: 1rpx solid var(--chip);
}
.rb-loading,
.rb-empty {
  padding: 20rpx 0;
  text-align: center;
}
.rb-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--sunken);
}
.rb-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.rb-avatar-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-base);
}
.rb-mid {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
}
.rb-title {
  font-size: var(--fs-body);
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.rb-sub {
  margin-top: 4rpx;
}
.rb-caution {
  color: var(--red);
  background: var(--red-soft);
  border-radius: var(--r-xs);
  padding: 4rpx 10rpx;
  margin-top: 8rpx;
  display: inline-block;
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  box-sizing: border-box;
}
.rb-likes {
  flex-shrink: 0;
  margin-top: 6rpx;
}
.rb-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}
.rb-act {
  flex: 1;
  text-align: center;
  font-size: var(--fs-body);
  padding: 14rpx 0;
  border-radius: 999rpx;
  background: #f2f3f7;
  color: var(--ink-2);
}
.rb-pub {
  background: var(--brand);
  color: #fff;
  font-weight: 600;
}

/* ---------- 按图找线大图 ---------- */
.fw {
  background: var(--card);
  border-radius: var(--radius);
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}
.fw-clip {
  max-height: 560rpx;
  overflow: hidden;
}
.fw-inner {
  position: relative;
}
.fw-img {
  width: 100%;
  display: block;
}
.fw-mk {
  position: absolute;
  min-width: 48rpx;
  height: 48rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  border: 4rpx solid #ffffff;
  transform: translate(-50%, -50%);
  color: #ffffff;
  font-size: var(--fs-xs);
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
}
.fw-mk.light {
  color: var(--ink);
}
.fw-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
}
.fw-title {
  font-size: var(--fs-base);
  font-weight: 800;
}
.fw-sub {
  font-size: var(--fs-sm);
  color: var(--ink-3);
  margin-top: 4rpx;
}
.fw-go {
  font-size: var(--fs-md);
  color: var(--brand-deep);
  font-weight: 700;
}
.fw-empty {
  display: flex;
  align-items: center;
}
.fw-empty-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--r-md);
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
