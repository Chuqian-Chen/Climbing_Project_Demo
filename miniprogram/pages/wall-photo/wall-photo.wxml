<view class="page-pad">

  <view class="between head">
    <view>
      <view class="bold">{{gymName}}</view>
      <view class="small faint">{{wallName}} · {{markers.length}} 条</view>
    </view>
    <view class="edit-toggle {{editMode ? 'on' : ''}}" wx:if="{{photo}}" bindtap="toggleEdit">
      {{editMode ? '完成' : '标注'}}
    </view>
  </view>

  <!-- 整墙照片 + 标记 -->
  <block wx:if="{{photo}}">
    <view class="wall-wrap" bindtap="onImgTap">
      <image id="wall-img" class="wall-img" src="{{photo}}" mode="widthFix" bindload="onImgLoad" />
      <!-- 一键识别全墙：当前预览颜色的候选点 -->
      <view
        wx:for="{{scanPreview}}"
        wx:key="index"
        class="scan-ring"
        style="left:{{item.x}}%;top:{{item.y}}%;border-color:{{scanColorHex}}"
      ></view>

      <!-- 选中线路的连线（一笔勾出整条线） -->
      <view
        wx:for="{{segs}}"
        wx:key="index"
        class="seg"
        style="left:{{item.left}}px;top:{{item.top}}px;width:{{item.len}}px;transform:rotate({{item.angle}}deg);background:{{segColor}}"
      ></view>

      <!-- 每条线的岩点圈：编辑时只显当前线，浏览时选中线高亮、未选中全部淡显 -->
      <block wx:for="{{markers}}" wx:key="routeId" wx:for-item="mk">
        <view
          wx:for="{{holds[mk.routeId]}}"
          wx:key="index"
          wx:if="{{editMode ? pendingRouteId === mk.routeId : selectedId === mk.routeId}}"
          class="hold-ring {{item.f ? 'ft' : ''}} {{(selectedId === mk.routeId || pendingRouteId === mk.routeId) ? 'on' : ''}}"
          style="left:{{item.x}}%;top:{{item.y}}%;border-color:{{mk.colorHex}}"
          data-rid="{{mk.routeId}}"
          data-idx="{{index}}"
          catchtap="onRingTap"
          catchlongpress="onRingLongPress"
        ><text class="hold-num">{{item.label}}</text></view>
      </block>

      <view
        wx:for="{{markers}}"
        wx:key="routeId"
        class="marker {{highlightId === item.routeId || selectedId === item.routeId ? 'hl' : ''}} {{selectedId && selectedId !== item.routeId ? 'dim' : ''}} {{item.colorLight ? 'light' : ''}}"
        style="left:{{item.x}}%;top:{{item.y}}%;background:{{item.colorHex}}"
        data-id="{{item.routeId}}"
        catchtap="onMarkerTap"
        catchlongpress="onMarkerLongPress"
      >
        <text class="marker-grade">{{item.grade}}</text>
      </view>
    </view>
    <view class="tip small muted" wx:if="{{editMode}}">
      {{pendingIdx >= 0 ? '按手序点图加点，点圈可改' : '先选下方线路'}}
    </view>
    <view class="sel-bar" wx:elif="{{selectedId}}">
      <view class="sel-head">
        <text class="bold">{{selectedName}} {{selectedGrade}}</text>
        <text class="small faint" wx:if="{{selectedSeq}}">{{selectedSeq}}</text>
      </view>
      <view class="sel-acts">
        <view class="btn btn-soft sel-btn" bindtap="goSelectedRoute">详情</view>
        <view class="btn btn-primary sel-btn" bindtap="goSelectedCheckin">打卡</view>
      </view>
    </view>
    <view class="tip small faint" wx:elif="{{markers.length}}">点徽章看走线</view>
  </block>

  <!-- 空状态 -->
  <view wx:else class="card empty">
    <view class="bold">还没有墙面照片</view>
    <view class="small faint empty-desc">拍整墙图，再标线</view>
  </view>

  <!-- 编辑面板 -->
  <view class="card" wx:if="{{editMode}}">
    <view class="field" wx:if="{{routeLabels.length}}">
      <text class="label">选线路</text>
      <picker range="{{routeLabels}}" value="{{pendingIdx}}" bindchange="onPickRoute">
        <view class="pick {{pendingIdx >= 0 ? 'has' : ''}}">{{pendingIdx >= 0 ? routeLabels[pendingIdx] : '选择线路 ›'}}</view>
      </picker>
    </view>
    <view class="field" wx:if="{{pendingRouteId}}">
      <text class="label">点的类型</text>
      <view class="ht-seg">
        <view class="ht-chip {{holdType === 'hand' ? 'on' : ''}}" data-t="hand" bindtap="setHoldType">手点</view>
        <view class="ht-chip {{holdType === 'foot' ? 'on' : ''}}" data-t="foot" bindtap="setHoldType">脚点</view>
      </view>
    </view>
    <view class="row" wx:if="{{pendingRouteId}}">
      <text class="small faint">已圈 {{holds[pendingRouteId] ? holds[pendingRouteId].length : 0}} 个点</text>
      <picker range="{{grades}}" bindchange="onEditGrade">
        <text class="small qg-link">改难度</text>
      </picker>
      <text class="small qg-link clear-link" bindtap="clearLine">清空本线</text>
      <view class="undo-btn small" bindtap="undoHold">⟲ 撤销上一个</view>
    </view>
    <view class="btn btn-soft ai-btn" wx:if="{{pendingRouteId}}" bindtap="aiAnnotate">
      AI 圈点
    </view>

    <view class="btn btn-soft ai-btn scan-btn" wx:if="{{photo && !scanItems.length}}" bindtap="scanWall">一键识别全墙（找出所有颜色的线）</view>
    <view class="scan" wx:if="{{scanItems.length}}">
      <view class="between scan-head">
        <text class="bold small">识别到 {{scanItems.length}} 种颜色</text>
        <text class="small faint" bindtap="closeScan">收起</text>
      </view>
      <view
        class="scan-row {{scanIdx === index ? 'on' : ''}}"
        wx:for="{{scanItems}}"
        wx:key="color"
        data-i="{{index}}"
        bindtap="previewScan"
      >
        <view class="hold-dot {{item.colorLight ? 'light' : ''}}" style="background:{{item.colorHex}}"></view>
        <text class="scan-name">{{item.colorName}}色 · {{item.count}} 个岩点</text>
        <view class="flex-1"></view>
        <text class="scan-act {{item.done ? 'done' : ''}}" data-i="{{index}}" catchtap="applyScan">{{item.done ? '已填入 ✓' : (item.routeId ? '填入「' + item.routeLabel + '」' : '新建这条线')}}</text>
      </view>
      <view class="small faint scan-tip">候选点来自颜色算法，同色的胶带 / 告示可能混入，填入后长按可删</view>
    </view>
    <!-- 快速建线：这面墙的新线直接在这里建 -->
    <view class="qc-toggle small" bindtap="toggleCreate">
      {{showCreate ? '收起' : '＋ 建线'}}{{routeLabels.length ? '' : '（先建一条）'}}
    </view>
    <block wx:if="{{showCreate || !routeLabels.length}}">
      <view class="field">
        <text class="label">岩点颜色</text>
        <picker range="{{colorNames}}" value="{{qcColorIdx}}" bindchange="onQcColor">
          <view class="pick {{qcColorIdx >= 0 ? 'has' : ''}}">{{qcColorIdx >= 0 ? colorNames[qcColorIdx] + '色' : '选择颜色 ›'}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">难度</text>
        <picker range="{{grades}}" value="{{qcGradeIdx}}" bindchange="onQcGrade">
          <view class="pick {{qcGradeIdx >= 0 ? 'has' : ''}}">{{qcGradeIdx >= 0 ? grades[qcGradeIdx] : '自己选 V 几 ›'}}</view>
        </picker>
      </view>
      <view class="field" wx:if="{{tapeLabels}}">
        <text class="label">标签参考</text>
        <picker range="{{tapeLabels}}" value="{{qcTapeIdx}}" bindchange="onQcTape">
          <view class="pick {{qcTapeIdx >= 0 ? 'has' : ''}}">{{qcTapeIdx >= 0 ? tapeLabels[qcTapeIdx] : '选填 ›'}}</view>
        </picker>
      </view>
      <view class="btn btn-primary qc-btn" bindtap="createRoute">建线并标注</view>
    </block>
  </view>

  <!-- 无照片时上传对所有人开放（共建）；已有照片后「更换」收进编辑模式，浏览者不打扰 -->
  <view class="btn btn-soft up-btn" wx:if="{{!photo || editMode}}" bindtap="choosePhoto">{{photo ? '换照片' : '上传墙面照'}}</view>
  <view class="btn btn-soft up-btn retire-btn" wx:if="{{editMode && isSetter}}" bindtap="retireWall">整墙下架</view>

  <!-- AI 检测用的离屏画布 -->
  <canvas type="2d" id="detect-canvas" class="detect-canvas"></canvas>

</view>
