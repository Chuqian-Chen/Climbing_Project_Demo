.head {
  margin-bottom: 20rpx;
}
.edit-toggle {
  font-size: var(--fs-md);
  color: var(--ink-2);
  background: #ffffff;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  box-shadow: var(--shadow-card);
}
.edit-toggle.on {
  background: var(--ink);
  color: #fff;
  font-weight: 700;
}

.wall-wrap {
  position: relative;
  border-radius: var(--radius);
  overflow: hidden;
  background: #16181f;
}
.wall-img {
  width: 100%;
  display: block;
}
.marker {
  position: absolute;
  transform: translate(-50%, -50%);
  min-width: 56rpx;
  height: 56rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  border: 4rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.45);
}
.marker-grade {
  color: #ffffff;
  font-size: var(--fs-xs);
  font-weight: 800;
}
.marker.light .marker-grade {
  color: #33363d;
}
.marker.hl {
  transform: translate(-50%, -50%) scale(1.3);
  border-color: #ffde59;
  z-index: 2;
  animation: pulse 1.2s ease infinite;
}
@keyframes pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255, 222, 89, 0.6); }
  50% { box-shadow: 0 0 0 16rpx rgba(255, 222, 89, 0); }
}

.tip {
  margin: 16rpx 6rpx 24rpx;
}

/* 连线段 */
.seg {
  position: absolute;
  height: 6rpx;
  margin-top: -3rpx;
  border-radius: var(--r-xs);
  opacity: 0.85;
  transform-origin: center;
  box-shadow: 0 0 6rpx rgba(0, 0, 0, 0.4);
}

/* 岩点圈注 */
.hold-ring {
  display: flex;
  align-items: center;
  justify-content: center;
}
.hold-num {
  color: #ffffff;
  font-size: var(--fs-xs);
  font-weight: 800;
  text-shadow: 0 0 6rpx rgba(0, 0, 0, 0.9);
}
.hold-ring {
  position: absolute;
  transform: translate(-50%, -50%);
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 6rpx solid;
  opacity: 0.75;
  box-shadow: 0 0 8rpx rgba(0, 0, 0, 0.35), inset 0 0 8rpx rgba(0, 0, 0, 0.15);
}
.hold-ring.on {
  opacity: 1;
  box-shadow: 0 0 0 6rpx rgba(255, 222, 89, 0.35), 0 0 10rpx rgba(0, 0, 0, 0.4);
}
/* 脚点：小号虚线圈，不编手序号 */
.hold-ring.ft {
  width: 40rpx;
  height: 40rpx;
  border-width: 4rpx;
  border-style: dashed;
  opacity: 0.65;
}
.hold-ring.ft.on {
  opacity: 0.9;
}

/* 手/脚点标注切换 */
.ht-seg {
  display: flex;
  gap: 12rpx;
}
.ht-chip {
  padding: 8rpx 32rpx;
  border-radius: 999rpx;
  background: #f2f3f7;
  color: var(--ink-2);
  font-size: var(--fs-md);
}
.ht-chip.on {
  background: var(--ink);
  color: #fff;
  font-weight: 700;
}
.marker.dim {
  opacity: 0.35;
}
.undo-btn {
  margin-left: auto;
  color: var(--brand-deep);
  font-weight: 600;
  padding: 8rpx 20rpx;
  background: var(--brand-soft);
  border-radius: 999rpx;
}
.qg-link {
  color: var(--brand);
  font-weight: 600;
  margin-left: 20rpx;
}
.clear-link {
  color: var(--red);
}
/* 选中线路后的 Beta 直达条 */
.beta-jump {
  background: #ffffff;
  border-radius: var(--r-sm);
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.beta-jump-link {
  color: var(--brand);
  font-weight: 700;
}

.empty {
  text-align: center;
  padding: 72rpx 40rpx;
}
.empty-desc {
  margin-top: 8rpx;
}

.field {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}
.label {
  width: 140rpx;
  font-size: var(--fs-body);
  color: var(--ink-2);
  flex-shrink: 0;
}
.pick {
  font-size: var(--fs-base);
  color: var(--ink-3);
  padding: 8rpx 0;
}
.pick.has {
  color: var(--ink);
  font-weight: 600;
}

.up-btn {
  margin-top: 8rpx;
}
.ai-btn {
  margin-top: 12rpx;
  font-size: var(--fs-body);
  padding: 14rpx 0;
}
.detect-canvas {
  position: fixed;
  left: -2000rpx;
  top: 0;
  width: 360px;
  height: 480px;
}
.qc-toggle {
  color: var(--brand-deep);
  font-weight: 600;
  padding: 12rpx 0;
}
.qc-input {
  flex: 1;
  font-size: var(--fs-base);
}
.qc-btn {
  margin-top: 12rpx;
  font-size: var(--fs-base);
  padding: 16rpx 0;
}

/* 整墙换线 */
.retire-btn {
  color: var(--red);
  margin-top: 16rpx;
}

/* ---------- 一键识别全墙 ---------- */
.scan-ring {
  position: absolute;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 4rpx dashed #ffffff;
  transform: translate(-50%, -50%);
  box-shadow: 0 0 0 2rpx rgba(0, 0, 0, 0.35);
  pointer-events: none;
  z-index: 3;
}
.scan {
  margin-top: 16rpx;
  background: var(--sunken);
  border-radius: var(--r-md);
  padding: 12rpx 20rpx 16rpx;
}
.scan-head {
  padding: 8rpx 0 4rpx;
}
.scan-row {
  display: flex;
  align-items: center;
  padding: 16rpx 12rpx;
  margin: 6rpx -12rpx 0;
  border-radius: var(--r-sm);
}
.scan-row.on {
  background: var(--card);
  box-shadow: var(--shadow-card);
}
.scan-name {
  font-size: var(--fs-body);
  margin-left: 14rpx;
}
.scan-act {
  font-size: var(--fs-md);
  color: var(--brand-deep);
  font-weight: 700;
  padding: 6rpx 0 6rpx 16rpx;
}
.scan-act.done {
  color: var(--green);
}
.scan-tip {
  margin-top: 10rpx;
  line-height: 1.5;
}
