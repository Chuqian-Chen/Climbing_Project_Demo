.author-info {
  margin-left: 16rpx;
}
.setter-badge {
  font-size: var(--fs-xs);
  color: var(--ai);
  background: transparent;
  border: 1rpx solid #cdbcf2;
  border-radius: var(--r-xs);
  padding: 2rpx 10rpx;
  font-weight: 600;
}
.ms-video-wrap {
  position: relative;
  display: inline-block;
}
.ms-cover {
  position: absolute;
  inset: 0;
  border-radius: var(--r-md);
  overflow: hidden;
  background: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
}
.ms-cover-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.ms-cover-play {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 8rpx;
  box-sizing: border-box;
}
.ms-cover-dur {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: var(--fs-sm);
  padding: 4rpx 14rpx;
  border-radius: var(--r-xs);
}

.cm-del {
  color: var(--ink-3);
  margin-right: 16rpx;
}

/* 易掉点警示条：核心信息，醒目但不刺眼 */
.caution-banner {
  display: flex;
  align-items: flex-start;
  background: var(--red-soft);
  border-left: 6rpx solid var(--red);
  border-radius: var(--r-sm);
  padding: 16rpx 20rpx;
  margin: 4rpx 0 16rpx;
}
.caution-tag {
  color: var(--red);
  font-size: var(--fs-sm);
  font-weight: 800;
  flex-shrink: 0;
  margin-right: 14rpx;
}
.caution-text {
  font-size: var(--fs-body);
  color: #7a3b3b;
  line-height: 1.5;
}

.del-beta {
  color: var(--red);
  padding: 8rpx 16rpx;
}
.edit-beta {
  color: var(--brand);
}
.follow {
  font-size: var(--fs-md);
  color: #fff;
  background: var(--brand);
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  font-weight: 600;
}
.follow.on {
  background: var(--chip);
  color: var(--ink-3);
}

/* 媒体区：视频+图片统一横滑条 */
.media-strip {
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.ms-video {
  display: inline-block;
  width: 600rpx;
  height: 420rpx;
  border-radius: var(--radius);
  background: #000;
  margin-right: 14rpx;
  vertical-align: top;
}
.ms-img {
  display: inline-block;
  width: 300rpx;
  height: 420rpx;
  border-radius: var(--radius);
  margin-right: 14rpx;
  vertical-align: top;
}
.media {
  background: linear-gradient(135deg, #23262f, #3a4051);
  height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  color: #fff;
}
.media-play {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  padding-left: 8rpx;
  box-sizing: border-box;
}
.media-dur {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  font-size: var(--fs-sm);
  background: rgba(0, 0, 0, 0.4);
  padding: 4rpx 14rpx;
  border-radius: var(--r-xs);
}
.media-hint {
  margin-top: 20rpx;
  opacity: 0.6;
}

.route-link {
  padding: 20rpx 24rpx;
}
.route-name {
  font-weight: 700;
  margin: 0 12rpx;
  max-width: 260rpx;
}

.title {
  font-size: var(--fs-xl);
  font-weight: 800;
  margin: 8rpx 4rpx 16rpx;
}
.meta-row {
  margin-bottom: 20rpx;
}

.steps {
  padding: 28rpx;
}
.step {
  position: relative;
  padding-left: 64rpx;
  padding-bottom: 32rpx;
}
.step:last-child {
  padding-bottom: 0;
}
.step::before {
  content: '';
  position: absolute;
  left: 20rpx;
  top: 48rpx;
  bottom: 0;
  width: 2rpx;
  background: var(--line);
}
.step:last-child::before {
  display: none;
}
.step-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.step-no {
  position: absolute;
  left: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-weight: 800;
  font-size: var(--fs-md);
  display: flex;
  align-items: center;
  justify-content: center;
}
.step-phase {
  font-weight: 800;
  font-size: var(--fs-base);
}
.step-text {
  color: var(--ink-2);
  font-size: var(--fs-body);
}

.acts {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.act {
  flex: 1;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 18rpx 0;
  text-align: center;
  font-size: var(--fs-body);
  font-weight: 600;
  box-shadow: var(--shadow-card);
  margin-right: 16rpx;
}
.act:last-child {
  margin-right: 0;
}
.act.liked {
  color: var(--red);
  background: var(--red-soft);
}
.act-heart {
  font-size: var(--fs-lg);
}
/* 原生 button 默认样式全量覆盖 */
.act.share {
  width: auto;
  min-height: 0;
  box-sizing: border-box;
  margin: 0;
  padding: 18rpx 0;
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.55;
  border: none;
  border-radius: 999rpx;
  background: #ffffff;
}
.act.share::after {
  border: none;
}

.cm {
  padding: 20rpx 24rpx;
  margin-bottom: 14rpx;
}
.cm-avatar {
  width: 56rpx;
  height: 56rpx;
  font-size: var(--fs-lg);
  margin-right: 14rpx;
}
.cm-text {
  font-size: var(--fs-body);
  margin-top: 4rpx;
}
.cm-input-wrap {
  display: flex;
  align-items: center;
  padding: 14rpx 14rpx 14rpx 28rpx;
}
.cm-input {
  flex: 1;
  font-size: var(--fs-body);
}
.cm-send {
  font-size: var(--fs-md);
  color: var(--ink-3);
  background: var(--chip);
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
}
.cm-send.on {
  color: #fff;
  background: var(--brand);
  font-weight: 600;
}
.tap {
  display: flex;
}
