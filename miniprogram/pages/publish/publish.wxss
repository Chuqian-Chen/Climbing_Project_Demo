.pub {
  padding-bottom: 60rpx;
}
.field {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}
.label {
  width: 140rpx;
  font-size: var(--fs-body);
  color: var(--ink-2);
  flex-shrink: 0;
}
.pick {
  font-size: var(--fs-base);
  color: var(--ink-3);
  padding: 8rpx 0;
}
.pick.has {
  color: var(--ink);
  font-weight: 600;
}

.sec-title {
  margin-bottom: 12rpx;
}
.lock-line {
  margin-top: 10rpx;
  font-weight: 600;
}
.title-hint {
  margin-left: 12rpx;
  font-weight: 400;
}
.tag-more {
  background: transparent;
  color: var(--brand-deep);
  border: 2rpx dashed #ffd9c4;
}
.pioneer {
  color: var(--green);
  font-weight: 600;
  margin: 8rpx 0 4rpx;
}
.nr-input {
  flex: 1;
  font-size: var(--fs-base);
}
.tips {
  background: var(--sunken);
  border-radius: var(--r-sm);
  padding: 16rpx 20rpx;
  margin-top: 14rpx;
  white-space: pre-line;
}

.media-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx 0 8rpx;
}
.media-item {
  position: relative;
  width: 196rpx;
  height: 196rpx;
  margin: 0 14rpx 14rpx 0;
  border-radius: var(--r-md);
  overflow: hidden;
}
.media-thumb {
  width: 100%;
  height: 100%;
}
.media-dur {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  font-size: var(--fs-xs);
  color: #fff;
  background: rgba(0, 0, 0, 0.5);
  padding: 2rpx 10rpx;
  border-radius: var(--r-xs);
}
.media-del {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: var(--fs-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}
.media-add {
  width: 196rpx;
  height: 196rpx;
  border-radius: var(--r-md);
  border: 2rpx dashed #d5d8de;
  color: var(--ink-3);
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}

.title-input {
  font-size: var(--fs-lg);
  font-weight: 600;
}

.edit-route-line {
  font-weight: 700;
  margin: 8rpx 0 6rpx;
}
.caution-row {
  display: flex;
  align-items: center;
  background: var(--red-soft);
  border-radius: var(--r-sm);
  padding: 14rpx 20rpx;
  margin-top: 20rpx;
}
.caution-label {
  color: var(--red);
  font-size: var(--fs-md);
  font-weight: 700;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.caution-input {
  flex: 1;
  font-size: var(--fs-body);
}
.steps-title {
  margin-bottom: 16rpx;
}
.step-field {
  margin-bottom: 20rpx;
}
.step-phase {
  font-size: var(--fs-md);
  font-weight: 700;
  color: var(--brand-deep);
  margin-bottom: 8rpx;
}
.step-input {
  width: 100%;
  box-sizing: border-box;
  background: var(--sunken);
  border-radius: var(--r-sm);
  padding: 16rpx 20rpx;
  font-size: var(--fs-body);
  min-height: 80rpx;
}

.vis {
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  background: var(--chip);
  color: var(--ink-2);
  font-size: var(--fs-md);
  margin-right: 16rpx;
}
.vis.on {
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-weight: 700;
}

.submit {
  margin-top: 8rpx;
}
.safety {
  text-align: center;
  margin-top: 20rpx;
}

/* ---------- 三步向导 ---------- */
.wz {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: var(--radius);
  padding: 20rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}
.wz-item {
  display: flex;
  align-items: center;
  color: var(--ink-3);
  flex-shrink: 0;
}
.wz-no {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--chip);
  color: var(--ink-3);
  font-size: var(--fs-sm);
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
}
.wz-label {
  font-size: var(--fs-body);
  font-weight: 600;
}
.wz-item.ok .wz-no {
  background: var(--brand-soft);
  color: var(--brand-deep);
}
.wz-item.on {
  color: var(--ink);
}
.wz-item.on .wz-no {
  background: var(--brand);
  color: #ffffff;
}
.wz-line {
  flex: 1;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--line);
  margin: 0 16rpx;
}
.wz-line.ok {
  background: var(--brand-soft);
}
.wz-route {
  background: var(--brand-soft);
  border-radius: var(--r-sm);
  padding: 14rpx 22rpx;
  margin-bottom: 20rpx;
}
.wz-nav {
  display: flex;
  margin-top: 8rpx;
}
.wz-back {
  flex: 1;
  margin-right: 20rpx;
}
.wz-next {
  flex: 2;
}
.wz-preview-title {
  font-size: var(--fs-lg);
  margin: 8rpx 0;
}
.wz-preview-caution {
  color: var(--red);
  margin-top: 8rpx;
}
