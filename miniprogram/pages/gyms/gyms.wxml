<view class="page-pad tabbar-pad">

  <!-- 错误兜底 -->
  <view class="err" wx:if="{{loadError}}">
    <text>页面加载出错：{{loadError}}</text>
    <text class="err-retry" bindtap="retry">重试</text>
  </view>

  <!-- 城市切换 -->
  <view class="city-row">
    <view
      class="city-chip {{cityKey === item.key ? 'on' : ''}}"
      wx:for="{{cities}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="pickCity"
    >{{item.name}}</view>
    <view class="flex-1"></view>
    <text class="small faint" wx:if="{{located}}">已按距离排序</text>
  </view>

  <view class="loc-tip" wx:if="{{locationDenied}}" bindtap="openLocationSetting">
    开启定位后可按距离排序 <text class="loc-link">去开启</text>
  </view>

  <!-- 快速筛选 -->
  <view class="kw-bar">
    <input class="kw-input" placeholder="搜馆名 / 区域，如「徐汇」「香蕉」" value="{{kw}}" bindinput="onKw" />
    <text class="count small faint">{{shown.length}}/{{gyms.length}} 家</text>
  </view>

  <view class="gym-card card" wx:for="{{shown}}" wx:key="id" data-id="{{item.id}}" bindtap="goGym" hover-class="gym-hover" style="border-left: 8rpx solid {{item.typeColor}}">
    <view class="gym-head">
      <view class="row">
        <view class="gym-name flex-1">{{item.name}}</view>
        <view class="gym-demo" wx:if="{{item.isDemo}}">演示数据</view>
        <view class="gym-demo gym-soon" wx:if="{{item.comingSoon}}">即将开业</view>
        <view class="gym-demo" wx:if="{{item.unlisted}}">待核实</view>
      </view>
      <view class="gym-area">{{item.area}}<text wx:if="{{item.price}}"> · ¥{{item.price}}</text></view>
      <view class="gym-dist" wx:if="{{item.distanceText}}">{{item.distanceText}}</view>
    </view>
    <view class="gym-body">
      <block wx:if="{{item.routeCount}}">
        <view class="between gym-stats">
          <text class="small muted">{{item.routeCount}} 条在墙</text>
          <text class="small muted" wx:if="{{item.weekCheckins}}">本周 {{item.weekCheckins}} 次打卡</text>
          <text class="small gym-new" wx:if="{{item.newCount}}">新线 {{item.newCount}}</text>
        </view>
      </block>
      <view class="small faint" wx:else>线路数据待共建 · 进馆打卡开个荒 →</view>
      <view class="gym-map" wx:if="{{item.lat}}" catchtap="openMap" data-id="{{item.id}}">打开地图 ›</view>
    </view>
  </view>

</view>
