.head-avatar {
  width: 108rpx;
  height: 108rpx;
  font-size: 56rpx;
  margin-right: 20rpx;
}
.head-nick {
  font-size: var(--fs-lg);
  font-weight: 800;
}
.head-setter {
  font-size: var(--fs-xs);
  color: var(--ai);
  background: transparent;
  border: 1rpx solid #cdbcf2;
  border-radius: var(--r-xs);
  padding: 4rpx 12rpx;
  font-weight: 600;
  vertical-align: middle;
}
.head-intro {
  margin-top: 4rpx;
}
.edit-btn {
  font-size: var(--fs-md);
  color: var(--brand-deep);
  background: var(--brand-soft);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
}
.tip {
  margin-top: 20rpx;
  background: var(--sunken);
  border-radius: var(--r-sm);
  padding: 14rpx 18rpx;
  font-size: var(--fs-sm);
  color: var(--ink-2);
}
.gym-row {
  margin-top: 16rpx;
}
.gym-pick {
  color: var(--brand-deep);
  font-weight: 600;
}

/* 编辑态 */
.edit-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--chip);
}
.edit-label {
  width: 120rpx;
  font-size: var(--fs-body);
  color: var(--ink-2);
}
.edit-input {
  flex: 1;
  font-size: var(--fs-base);
}
.avatar-btn {
  background: transparent;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  line-height: 1;
  border: none;
}
.avatar-btn::after {
  border: none;
}
.avatar-hint {
  margin-left: 16rpx;
}
.edit-actions {
  margin-top: 24rpx;
  gap: 20rpx;
}
.cancel {
  margin-right: 20rpx;
}

.counts {
  padding: 28rpx 24rpx;
}

.seg {
  display: flex;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  font-size: var(--fs-md);
  color: var(--ink-2);
  padding: 12rpx 0;
  border-radius: 999rpx;
}
.seg-item.on {
  background: var(--ink);
  color: #fff;
  font-weight: 700;
}

.follow-item {
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
.follow-info {
  margin-left: 16rpx;
}

.set-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.danger {
  color: var(--red);
}
