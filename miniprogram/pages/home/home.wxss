.search-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 18rpx 28rpx;
  margin-bottom: 20rpx;
}
.load-err {
  background: var(--red-soft);
  color: #b23b3b;
  border-radius: var(--r-md);
  padding: 16rpx 24rpx;
  font-size: var(--fs-md);
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.load-err-retry {
  color: var(--brand-deep);
  font-weight: 700;
  padding-left: 20rpx;
}

/* 首次引导：一行轻提示 */
.onboard-slim {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff7f2;
  border-radius: var(--r-sm);
  padding: 14rpx 22rpx;
  margin-bottom: 16rpx;
}
.onboard-slim-text {
  font-size: var(--fs-md);
  color: #c05621;
  flex: 1;
}
.onboard-close {
  color: #c9855f;
  padding: 0 8rpx;
}

.slim {
  background: #ffffff;
  border-radius: var(--r-sm);
  padding: 16rpx 22rpx;
  margin-bottom: 16rpx;
}

/* 区块标题行 */
.gym-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 4rpx 14rpx;
}
.feed-head {
  margin-top: 24rpx;
}
.section-label {
  font-size: var(--fs-lg);
  font-weight: 800;
}
.section-more {
  font-size: var(--fs-md);
  color: var(--ink-3);
}

/* 附近岩馆：紧凑 chips */
.gymchips {
  white-space: nowrap;
  margin: 0 -24rpx;
  padding: 0 24rpx;
}
.gymchip {
  display: inline-flex;
  align-items: baseline;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  margin-right: 14rpx;
}
.gymchip-name {
  font-size: var(--fs-body);
  font-weight: 600;
}
.gymchip-meta {
  font-size: var(--fs-xs);
  color: var(--ink-3);
  margin-left: 10rpx;
}
.gymchip-count {
  color: var(--brand);
  font-weight: 600;
}

/* 难度筛选档 */
.band-row {
  white-space: nowrap;
  margin: 0 -24rpx 16rpx;
  padding: 0 24rpx;
}
.band-chip {
  display: inline-block;
  padding: 10rpx 30rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--ink-2);
  font-size: var(--fs-md);
  margin-right: 14rpx;
}
.band-chip.on {
  background: var(--ink);
  color: #fff;
  font-weight: 700;
}
.band-empty {
  text-align: center;
  padding: 40rpx 0;
}

/* Beta 双列瀑布流 */
.feed {
  display: flex;
  align-items: flex-start;
}
.feed-col {
  flex: 1;
  min-width: 0;
}
.feed-col:first-child {
  margin-right: 16rpx;
}
