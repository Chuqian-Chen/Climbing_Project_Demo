<view class="page-pad tabbar-pad">

  <view class="search-bar" bindtap="goSearch">
    <text class="faint">搜线路或岩馆</text>
  </view>

  <view class="load-err" wx:if="{{loadError}}">
    <text>数据加载出错：{{loadError}}</text>
    <text class="load-err-retry" bindtap="retry">重试</text>
  </view>

  <view class="onboard-slim" wx:if="{{!onboarded}}">
    <text class="onboard-slim-text" bindtap="goProfile">填身高臂展，标出适合你的 Beta ›</text>
    <text class="onboard-close" bindtap="dismissOnboard">✕</text>
  </view>

  <!-- 主环 1：上次没完的线 -->
  <view class="card proj" wx:if="{{projectRoute}}">
    <view class="small muted">继续磕线</view>
    <view class="row proj-id">
      <view class="hold-dot {{projectRoute.colorLight ? 'light' : ''}}" style="background:{{projectRoute.colorHex}}"></view>
      <text class="bold ellipsis">{{projectRoute.name}}</text>
      <view class="grade-badge" style="background:{{projectRoute.gradeColor}}">{{projectRoute.grade}}</view>
    </view>
    <view class="small faint">{{projectRoute.gymName}}<text wx:if="{{projectRoute.wallName}}"> · {{projectRoute.wallName}}</text></view>
    <view class="proj-acts">
      <view class="btn btn-soft flex-1" catchtap="goProject">看走线</view>
      <view class="btn btn-primary flex-1" catchtap="goProjectCheckin">打卡</view>
    </view>
  </view>

  <!-- 主环 2：去哪爬 -->
  <view class="gym-row-head">
    <text class="section-label">去哪爬</text>
    <text class="section-more" bindtap="goGyms">全部岩馆 ›</text>
  </view>
  <view
    class="card near-card"
    wx:for="{{gyms}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="goGym"
    hover-class="near-hover"
  >
    <view class="between">
      <view class="flex-1 near-mid">
        <view class="near-name ellipsis">{{item.name}}</view>
        <view class="small faint">
          {{item.area}}<text wx:if="{{item.distanceText}}"> · {{item.distanceText}}</text>
        </view>
      </view>
      <view class="near-side">
        <text class="small near-count" wx:if="{{item.routeCount}}">{{item.routeCount}} 条</text>
        <text class="small faint" wx:else>待共建</text>
        <text class="faint"> ›</text>
      </view>
    </view>
  </view>

  <!-- 次要：热门 Beta -->
  <view class="gym-row-head feed-head">
    <text class="section-label">热门 Beta</text>
  </view>
  <scroll-view scroll-x class="band-row" enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{gradeBands}}"
      wx:key="key"
      class="band-chip {{bandKey === item.key ? 'on' : ''}}"
      data-key="{{item.key}}"
      bindtap="pickBand"
    >{{item.label}}</view>
  </scroll-view>
  <view class="band-empty small faint" wx:if="{{bandEmpty}}">这档暂无 Beta</view>
  <view class="feed">
    <view class="feed-col">
      <beta-tile wx:for="{{betaColL}}" wx:key="id" beta="{{item}}" />
    </view>
    <view class="feed-col">
      <beta-tile wx:for="{{betaColR}}" wx:key="id" beta="{{item}}" />
    </view>
  </view>

</view>
