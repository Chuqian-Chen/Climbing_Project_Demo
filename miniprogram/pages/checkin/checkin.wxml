<view class="page-pad" wx:if="{{loadFailed}}">
  <view class="card ck-missing">
    <view class="bold">线路不存在或已下架</view>
    <view class="small muted ck-missing-desc">可能已换线</view>
    <view class="btn btn-soft ck-missing-btn" bindtap="goBack">返回</view>
  </view>
</view>

<view class="page-pad" wx:if="{{route}}">

  <!-- 线路摘要（带线路图） -->
  <view class="card">
    <view class="row">
      <image wx:if="{{route.photo}}" class="ck-photo" src="{{route.photo}}" mode="aspectFill" bindtap="previewPhoto" />
      <view class="flex-1">
        <view class="row">
          <view class="hold-dot {{route.colorLight ? 'light' : ''}}" style="background:{{route.colorHex}}"></view>
          <text class="r-name ellipsis">{{route.name}}</text>
          <view class="grade-badge" wx:if="{{route.grade}}" style="background:{{route.gradeColor}}">{{route.grade}}</view>
        </view>
        <view class="small faint ck-gym">{{route.gymName}}<text wx:if="{{route.wallName}}"> · {{route.wallName}}</text></view>
      </view>
    </view>
  </view>

  <block wx:if="{{!done}}">
    <!-- 完攀方式 -->
    <view class="card">
      <view class="bold f-title">结果</view>
      <view class="res-row">
        <view class="res {{result === 'flash' ? 'on flash' : ''}}" data-r="flash" bindtap="setResult">
          <view class="res-name">闪送</view>
        </view>
        <view class="res {{result === 'top' ? 'on top' : ''}}" data-r="top" bindtap="setResult">
          <view class="res-name">完攀</view>
        </view>
        <view class="res {{result === 'attempt' ? 'on att' : ''}}" data-r="attempt" bindtap="setResult">
          <view class="res-name">磕线中</view>
        </view>
      </view>
    </view>

    <!-- 尝试次数 -->
    <view class="card" wx:if="{{result !== 'flash'}}">
      <view class="between">
        <text class="bold">尝试次数</text>
        <view class="stepper">
          <view class="st-btn" bindtap="minusAttempt">−</view>
          <view class="st-num">{{attempts}}</view>
          <view class="st-btn" bindtap="addAttempt">＋</view>
        </view>
      </view>
    </view>

    <!-- 难度感受 -->
    <view class="card">
      <view class="bold f-title">定级感受 <text class="small faint">选填</text></view>
      <view class="row">
        <view class="feel-chip {{feel === 'soft' ? 'on' : ''}}" data-f="soft" bindtap="setFeel">偏软</view>
        <view class="feel-chip {{feel === 'fair' ? 'on' : ''}}" data-f="fair" bindtap="setFeel">准确</view>
        <view class="feel-chip {{feel === 'hard' ? 'on' : ''}}" data-f="hard" bindtap="setFeel">偏辣</view>
      </view>
    </view>

    <!-- 备注 -->
    <view class="card">
      <textarea
        class="note"
        placeholder="备注（选填）"
        maxlength="60"
        value="{{note}}"
        auto-height
        bindinput="onNoteInput"
      />
    </view>

    <view class="btn btn-primary" bindtap="submit">打卡</view>
  </block>

  <!-- 打卡成功 -->
  <block wx:else>
    <view class="card done fade-in">
      <view class="done-title">已打卡</view>
      <view class="small muted">今天第 {{doneInfo.todayCount}} 条 · {{doneInfo.checkin.resultText}}「{{route.name}}」{{route.grade}}</view>
      <view class="new-badge" wx:if="{{doneInfo.newBadges && doneInfo.newBadges.length}}">
        解锁成就：{{doneInfo.newBadges[0].name}}
      </view>

      <block wx:if="{{!posterPath}}">
        <view class="btn btn-primary done-btn" bindtap="genPoster">生成海报</view>
      </block>
      <block wx:else>
        <image class="poster-img" src="{{posterPath}}" mode="widthFix" bindtap="previewPoster" />
        <view class="row poster-acts">
          <view class="btn btn-soft flex-1 poster-save" bindtap="savePoster">存相册</view>
          <button class="btn btn-primary flex-1 poster-share" open-type="share">分享</button>
        </view>
      </block>

      <view class="row done-links">
        <view class="done-link" bindtap="backToRoute">返回线路</view>
        <view class="done-link" bindtap="goLogbook">足迹 ›</view>
      </view>
    </view>
  </block>

  <!-- 离屏海报画布 -->
  <canvas type="2d" id="poster" class="poster-canvas"></canvas>
</view>
