.ck-photo {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--r-md);
  margin-right: 20rpx;
  background: var(--chip);
  flex-shrink: 0;
}
.ck-gym {
  margin-top: 8rpx;
  padding-left: 40rpx;
}
.r-name {
  font-weight: 800;
  font-size: var(--fs-lg);
  margin: 0 12rpx;
  max-width: 300rpx;
}
.f-title {
  margin-bottom: 20rpx;
}

.res-row {
  display: flex;
  gap: 16rpx;
}
.res {
  flex: 1;
  text-align: center;
  border-radius: var(--radius);
  background: var(--sunken);
  padding: 24rpx 0;
  border: 3rpx solid transparent;
  margin-right: 16rpx;
}
.res:last-child {
  margin-right: 0;
}
.res.on.flash { background: #fff9e6; border-color: #ffd666; }
.res.on.top { background: #eefaf3; border-color: #62c78f; }
.res.on.att { background: var(--brand-soft); border-color: #ff9a66; }
.res-name { font-weight: 800; font-size: var(--fs-body); margin-top: 6rpx; }
.res-desc { font-size: var(--fs-xs); color: var(--ink-3); margin-top: 2rpx; }

.stepper {
  display: flex;
  align-items: center;
}
.st-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--chip);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-lg);
  color: var(--ink-2);
}
.st-num {
  width: 90rpx;
  text-align: center;
  font-size: var(--fs-lg);
  font-weight: 800;
}

.feel-chip {
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: var(--chip);
  color: var(--ink-2);
  font-size: var(--fs-body);
  margin-right: 16rpx;
}
.feel-chip.on {
  background: var(--ink);
  color: #fff;
  font-weight: 700;
}

.note {
  width: 100%;
  box-sizing: border-box;
  font-size: var(--fs-body);
  min-height: 60rpx;
}

.done {
  text-align: center;
  padding: 48rpx 32rpx;
}
.ck-missing {
  padding: 60rpx 32rpx;
  text-align: center;
}
.ck-missing-desc {
  margin-top: 10rpx;
}
.ck-missing-btn {
  margin-top: 28rpx;
}
.done-title {
  font-size: 40rpx;
  font-weight: 800;
  margin: 12rpx 0 8rpx;
}
.new-badge {
  display: inline-block;
  margin-top: 20rpx;
  background: #fff7e6;
  color: #8a6a2f;
  font-size: var(--fs-body);
  font-weight: 600;
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
}
.done-btn {
  margin-top: 36rpx;
}
.poster-img {
  width: 420rpx;
  border-radius: var(--radius);
  margin-top: 32rpx;
  box-shadow: var(--shadow-float);
}
.poster-acts {
  margin-top: 28rpx;
  gap: 16rpx;
}
.poster-save {
  margin-right: 16rpx;
}
.poster-share {
  font-size: var(--fs-base);
  margin: 0;
  min-height: 0;
  line-height: inherit;
  border: none;
}
.poster-share::after {
  border: none;
}
.done-links {
  justify-content: center;
  margin-top: 32rpx;
}
.done-link {
  color: var(--ink-3);
  font-size: var(--fs-md);
  margin: 0 24rpx;
}

.poster-canvas {
  position: fixed;
  left: -2000rpx;
  top: 0;
  width: 300px;
  height: 480px;
}

/* ---------- 下一条可以试试 ---------- */
.nx {
  margin-top: 32rpx;
  text-align: left;
  border-top: 2rpx solid var(--line);
  padding-top: 24rpx;
}
.nx-title {
  font-size: var(--fs-body);
  font-weight: 700;
  margin-bottom: 8rpx;
}
.nx-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.nx-item:last-child {
  border-bottom: 0;
}
.nx-name {
  font-size: var(--fs-body);
  font-weight: 700;
  margin: 0 12rpx;
}
.nx-grade {
  min-width: 56rpx;
  font-size: var(--fs-sm);
}
.nx-why {
  font-size: var(--fs-xs);
  color: var(--brand-deep);
  background: var(--brand-soft);
  border-radius: var(--r-xs);
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
}
.nx-meta {
  font-size: var(--fs-sm);
  color: var(--ink-3);
}
