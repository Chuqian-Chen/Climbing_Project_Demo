  margin-right: 20rpx;
}
.u-main {
  margin-right: 12rpx;
}
.u-nick {
  font-size: var(--fs-lg);
  font-weight: 800;
}
.u-setter {
  font-size: var(--fs-xs);
  color: var(--ai);
