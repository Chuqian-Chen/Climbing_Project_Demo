.err {
  background: var(--red-soft);
  color: #b23b3b;
  border-radius: var(--r-md);
  padding: 16rpx 24rpx;
  font-size: var(--fs-md);
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.err-retry {
  color: var(--brand-deep);
  font-weight: 700;
  padding-left: 20rpx;
}
.stats {
  display: flex;
}
.stat {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 44rpx;
  font-weight: 800;
}
.stat-sub {
  font-size: var(--fs-sm);
  font-weight: 400;
}
.stat-label {
  font-size: var(--fs-sm);
  color: var(--ink-3);
  margin-top: 4rpx;
}

.heat-title {
  margin-bottom: 20rpx;
}
.heat {
  display: grid;
  grid-template-columns: repeat(14, 1fr);
  gap: 8rpx;
}
.heat-cell {
  height: 36rpx;
  border-radius: var(--r-xs);
  background: #eef0f3;
}
.heat-cell.lv1 { background: #ffd0b8; }
.heat-cell.lv2 { background: #ff9a66; }
.heat-cell.lv3 { background: var(--brand); }
.heat-cell.today { outline: 3rpx solid #1b1e28; outline-offset: -3rpx; }

.pyr-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}
.pyr-grade {
  width: 80rpx;
  font-weight: 800;
  font-size: var(--fs-body);
}
.pyr-track {
  flex: 1;
  background: var(--chip);
  border-radius: 999rpx;
  height: 28rpx;
  overflow: hidden;
}
.pyr-bar {
  height: 100%;
  border-radius: 999rpx;
  min-width: 28rpx;
}
.pyr-count {
  width: 60rpx;
  text-align: right;
  font-size: var(--fs-md);
  color: var(--ink-2);
}

.badges {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}
.badge {
  text-align: center;
  padding: 16rpx 4rpx;
  border-radius: var(--r-md);
  background: var(--sunken);
  filter: grayscale(1);
  opacity: 0.55;
}
.badge.on {
  filter: none;
  opacity: 1;
  background: #fff7f2;
}
.badge-name {
  font-size: var(--fs-sm);
  font-weight: 700;
  margin-top: 6rpx;
}
.badge-desc {
  font-size: var(--fs-xs);
  color: var(--ink-3);
  margin-top: 2rpx;
}

.tl-date {
  font-size: var(--fs-md);
  color: var(--ink-3);
  margin: 20rpx 0 12rpx;
}
.tl-item {
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
}
.tl-name {
  font-weight: 700;
  margin: 0 12rpx;
  max-width: 240rpx;
}
.tl-gym {
  margin-top: 6rpx;
  padding-left: 66rpx;
}
.tl-note {
  margin-top: 8rpx;
  padding-left: 66rpx;
}

.seed {
  text-align: center;
  color: var(--brand-deep);
  font-size: var(--fs-md);
  margin-top: 8rpx;
}
