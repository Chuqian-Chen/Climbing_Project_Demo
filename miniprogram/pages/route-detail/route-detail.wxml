<view class="page-pad" wx:if="{{loadFailed}}">
  <view class="card rd-missing">
    <view class="bold">线路不存在或已下架</view>
    <view class="small muted rd-missing-desc">可能已换线，去墙上看新线</view>
    <view class="btn btn-soft rd-missing-btn" bindtap="goBackHome">返回</view>
  </view>
</view>

<view class="page-pad rd-page" wx:if="{{route}}">

  <!-- 图示：线路照片 / 墙面走线 -->
  <image
    wx:if="{{route.photo}}"
    class="hero-photo"
    src="{{route.photo}}"
    mode="widthFix"
    bindtap="previewPhoto"
  />
  <view wx:elif="{{wallRef && wallRef.photo}}" class="hero-wall" bindtap="goWall">
    <image class="hero-wall-img" src="{{wallRef.photo}}" mode="widthFix" />
    <view
      wx:for="{{wallRef.holds}}"
      wx:key="index"
      class="hero-ring {{item.f ? 'ft' : ''}}"
      style="left:{{item.x}}%;top:{{item.y}}%;border-color:{{route.colorHex}}"
    ><text class="hero-num">{{item.label}}</text></view>
    <view
      wx:if="{{wallRef.hasMarker}}"
      class="hero-dot {{route.colorLight ? 'light' : ''}}"
      style="left:{{wallRef.x}}%;top:{{wallRef.y}}%;background:{{route.colorHex}}"
    >
      <text class="hero-dot-t">{{route.grade}}</text>
    </view>
    <view class="hero-wall-tip small">看整墙</view>
  </view>

  <!-- 身份 -->
  <view class="card main">
    <view class="row">
      <view class="hold-dot {{route.colorLight ? 'light' : ''}}" style="background:{{route.colorHex}}"></view>
      <text class="main-name ellipsis">{{route.name}}</text>
      <view class="badge-new" wx:if="{{route.isNew}}">新线</view>
      <view class="badge-warn" wx:if="{{route.removingSoon}}">{{route.daysLeft === 0 ? '今日拆' : route.daysLeft + '天拆'}}</view>
      <view class="flex-1"></view>
      <view class="grade-badge main-grade" style="background:{{route.gradeColor}}">{{route.grade}}</view>
    </view>
    <view class="small faint main-meta">{{route.gymName}}<text wx:if="{{route.wallName}}"> · {{route.wallName}}</text></view>
    <view class="small muted main-meta">
      {{route.sendsTotal}} 人完攀<text wx:if="{{route.betaCount}}"> · {{route.betaCount}} 条 Beta</text>
    </view>
    <view class="removed-banner" wx:if="{{route.possiblyRemoved}}">{{route.reportCount}} 位岩友报告此线可能已换线</view>
    <view class="small edit-link" wx:if="{{canEdit}}" bindtap="toggleManage">{{showManage ? '收起' : '管理'}}</view>
    <view class="row edit-links" wx:if="{{showManage}}">
      <picker range="{{gradeOpts}}" bindchange="onGradeEdit">
        <text class="small edit-link">改难度</text>
      </picker>
      <picker range="{{colorOpts}}" bindchange="onColorEdit">
        <text class="small edit-link">改颜色</text>
      </picker>
      <view class="flex-1"></view>
      <text class="small edit-link del-link" bindtap="deleteRouteTap">删除</text>
    </view>
    <view class="add-photo small faint" wx:if="{{!route.photo && !(wallRef && wallRef.photo)}}" bindtap="addRoutePhoto">＋ 补照片</view>
  </view>

  <!-- 走线：手序一眼看懂 -->
  <view class="card seq-card" wx:if="{{seqChips.length}}" bindtap="goWall">
    <view class="between">
      <text class="bold">走线</text>
      <text class="small faint" wx:if="{{wallRef && wallRef.photo}}">看墙面 ›</text>
    </view>
    <scroll-view scroll-x class="seq-row" enhanced show-scrollbar="{{false}}">
      <block wx:for="{{seqChips}}" wx:key="index">
        <view class="seq-chip" style="border-color:{{route.colorHex}}">{{item.label}}</view>
        <text class="seq-arrow" wx:if="{{index < seqChips.length - 1}}">→</text>
      </block>
    </scroll-view>
  </view>
  <view class="card seq-card seq-empty" wx:elif="{{wallRef && wallRef.photo}}" bindtap="goWall">
    <view class="between">
      <text class="bold">走线</text>
      <text class="small faint">去圈点 ›</text>
    </view>
    <view class="small muted">这条线还没标点</view>
  </view>

  <!-- 两个主操作 -->
  <view class="actions">
    <view class="btn btn-primary act-main" bindtap="goCheckin">打卡</view>
    <view class="btn btn-soft act-main" bindtap="goPublish">发 Beta</view>
    <view class="act-side {{route.faved ? 'on' : ''}}" bindtap="toggleFav">{{route.faved ? '★' : '☆'}}</view>
  </view>

  <!-- AI 路线预判：视觉模型看图分析（有缓存直接展示）> 岩点几何规则 -->
  <view class="card ai" wx:if="{{aiBeta || analysis}}">
    <view class="between">
      <text class="bold">AI 路线预判</text>
      <text class="small faint">{{aiBeta ? '看图分析 · ' + aiBeta.date : '规则预判 · 仅供参考'}}</text>
    </view>
    <block wx:if="{{aiBeta}}">
      <view class="ai-tip small" wx:for="{{aiBeta.tips}}" wx:key="index">· {{item}}</view>
      <block wx:if="{{aiBeta.moves.length}}">
        <view class="ai-sub small bold">逐手拆解</view>
        <view class="ai-tip small" wx:for="{{aiBeta.moves}}" wx:key="index">{{item}}</view>
      </block>
      <view class="ai-again small" bindtap="runAiBeta">{{aiBetaLoading ? '分析中…' : '重新分析'}}</view>
    </block>
    <block wx:else>
      <view class="ai-tip small" wx:for="{{analysis}}" wx:key="index">· {{item}}</view>
      <block wx:if="{{analysisMoves && analysisMoves.length}}">
        <view class="ai-sub small bold">逐手拆解（按标注手序）</view>
        <view class="ai-tip small" wx:for="{{analysisMoves}}" wx:key="index">{{item}}</view>
      </block>
      <view class="btn btn-soft ai-deep" wx:if="{{aiBetaAvailable}}" bindtap="runAiBeta">{{aiBetaLoading ? 'AI 正在看图分析…' : '让 AI 看图深度分析'}}</view>
    </block>
  </view>

  <!-- Beta -->
  <view class="section-title">
    Beta ({{betas.length}})
    <view class="hfilter {{onlyMyHeight ? 'on' : ''}}" wx:if="{{hasHeight}}" bindtap="toggleHeightFilter">适合我</view>
  </view>
  <beta-card wx:for="{{shownBetas}}" wx:key="id" beta="{{item}}" showRoute="{{false}}" />
  <empty-state
    wx:if="{{!shownBetas.length}}"
    title="{{onlyMyHeight ? '暂无匹配身高的 Beta' : '还没有 Beta'}}"
    desc="{{onlyMyHeight ? '关掉筛选看全部' : '爬过可以发'}}"
    btnText="发 Beta"
    bind:action="goPublish"
  />

  <view class="small faint report-link" bindtap="reportRemoved">{{route.myReported ? '已报告换线' : '报告换线'}}</view>
  <view class="safety small faint">攀岩有风险，Beta 仅供参考，注意落点保护</view>
</view>
