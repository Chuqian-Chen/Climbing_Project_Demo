<view class="page-pad" wx:if="{{loadFailed}}">
  <view class="card rd-missing">
    <view class="bold">这条线路不存在或已下架</view>
    <view class="small muted rd-missing-desc">可能已换线拆除，去墙上看看新线吧</view>
    <view class="btn btn-soft rd-missing-btn" bindtap="goBackHome">返回</view>
  </view>
</view>

<view class="page-pad" wx:if="{{route}}">

  <!-- 图示：线路照片 > 墙面定位图 -->
  <image
    wx:if="{{route.photo}}"
    class="hero-photo"
    src="{{route.photo}}"
    mode="widthFix"
    bindtap="previewPhoto"
  />
  <view wx:elif="{{wallRef && wallRef.photo}}" class="hero-wall" bindtap="goWall">
    <image class="hero-wall-img" src="{{wallRef.photo}}" mode="widthFix" />
    <!-- 这条线用到的每个岩点 -->
    <view
      wx:for="{{wallRef.holds}}"
      wx:key="index"
      class="hero-ring"
      style="left:{{item.x}}%;top:{{item.y}}%;border-color:{{route.colorHex}}"
    ><text class="hero-num">{{item.label}}</text></view>
    <view
      class="hero-dot {{route.colorLight ? 'light' : ''}}"
      style="left:{{wallRef.x}}%;top:{{wallRef.y}}%;background:{{route.colorHex}}"
    >
      <text class="hero-dot-t">{{route.grade}}</text>
    </view>
    <view class="hero-wall-tip small">{{wallRef.holds.length ? wallRef.holds.length + ' 个岩点已圈注 · 点击放大' : '墙面位置 · 点击查看'}}</view>
  </view>

  <!-- 线路信息（精简） -->
  <view class="card main">
    <view class="row">
      <view class="hold-dot {{route.colorLight ? 'light' : ''}}" style="background:{{route.colorHex}}"></view>
      <text class="main-name ellipsis">{{route.name}}</text>
      <view class="badge-new" wx:if="{{route.isNew}}">新线</view>
      <view class="flex-1"></view>
      <view class="grade-badge main-grade" style="background:{{route.gradeColor}}">{{route.grade}}</view>
    </view>
    <view class="small faint main-meta">{{route.gymName}}<text wx:if="{{route.wallName}}"> · {{route.wallName}}{{route.wallAngle ? ' ' + route.wallAngle : ''}}</text> · {{route.setterName}} 定线</view>
    <view class="row edit-links" wx:if="{{canEdit}}">
      <picker range="{{gradeOpts}}" bindchange="onGradeEdit">
        <text class="small edit-link">改难度</text>
      </picker>
      <picker range="{{colorOpts}}" bindchange="onColorEdit">
        <text class="small edit-link">改颜色</text>
      </picker>
      <view class="flex-1"></view>
      <text class="small edit-link del-link" bindtap="deleteRouteTap">删除线路</text>
    </view>
    <view class="removed-banner" wx:if="{{route.possiblyRemoved}}">{{route.reportCount}} 位岩友报告此线可能已换线</view>
    <view class="small main-meta">
      <text class="muted">{{route.sendsTotal}} 人完攀 · {{route.attempts}} 次尝试 · </text>
      <text class="{{route.removingSoon ? 'warn' : 'muted'}}">{{route.removingSoon ? (route.daysLeft === 0 ? '今日拆线' : route.daysLeft + ' 天后拆线') : route.removeDate + ' 拆线'}}</text>
    </view>
    <view class="row wrap main-tags" wx:if="{{route.tags.length}}">
      <text class="tag" wx:for="{{route.tags}}" wx:key="*this">{{item}}</text>
    </view>

    <!-- 难度共识（展示条，投票在打卡时进行） -->
    <view class="feel" wx:if="{{route.feelTotal}}">
      <view class="feel-bar">
        <view class="feel-soft" style="width:{{route.softPct}}%"></view>
        <view class="feel-fair" style="width:{{route.fairPct}}%"></view>
        <view class="feel-hard" style="width:{{route.hardPct}}%"></view>
      </view>
      <view class="small faint feel-line">定级感受：偏软 {{route.softPct}}% · 准确 {{route.fairPct}}% · 偏辣 {{route.hardPct}}%</view>
    </view>

    <view class="add-photo small faint" wx:if="{{!route.photo && !(wallRef && wallRef.photo)}}" bindtap="addRoutePhoto">＋ 补一张线路照片</view>
  </view>

  <!-- 操作：只留两个 -->
  <view class="actions">
    <view class="btn btn-primary act-main" bindtap="goCheckin">打卡</view>
    <view class="act-side {{route.faved ? 'on' : ''}}" bindtap="toggleFav">{{route.faved ? '★' : '☆'}}</view>
  </view>
  <view class="small faint report-link" bindtap="reportRemoved">{{route.myReported ? '已报告换线，等待更多岩友确认' : '这条线拆了？报告已换线'}}</view>

  <!-- AI 路线预判：视觉模型看图分析（有缓存直接展示）> 岩点几何规则 -->
  <view class="card ai" wx:if="{{aiBeta || analysis}}">
    <view class="between">
      <text class="bold">AI 路线预判</text>
      <text class="small faint">{{aiBeta ? '看图分析 · ' + aiBeta.date : '规则预判 · 仅供参考'}}</text>
    </view>
    <block wx:if="{{aiBeta}}">
      <view class="ai-tip small" wx:for="{{aiBeta.tips}}" wx:key="index">· {{item}}</view>
      <block wx:if="{{aiBeta.moves.length}}">
        <view class="ai-sub small bold">逐手拆解</view>
        <view class="ai-tip small" wx:for="{{aiBeta.moves}}" wx:key="index">{{item}}</view>
      </block>
      <view class="ai-again small" bindtap="runAiBeta">{{aiBetaLoading ? '分析中…' : '重新分析'}}</view>
    </block>
    <block wx:else>
      <view class="ai-tip small" wx:for="{{analysis}}" wx:key="index">· {{item}}</view>
      <block wx:if="{{analysisMoves && analysisMoves.length}}">
        <view class="ai-sub small bold">逐手拆解（按标注手序）</view>
        <view class="ai-tip small" wx:for="{{analysisMoves}}" wx:key="index">{{item}}</view>
      </block>
      <view class="btn btn-soft ai-deep" wx:if="{{aiBetaAvailable}}" bindtap="runAiBeta">{{aiBetaLoading ? 'AI 正在看图分析…' : '让 AI 看图深度分析'}}</view>
    </block>
  </view>

  <!-- 有线路照片时，墙面位置作为次级入口 -->
  <view class="card wall-link" wx:if="{{route.photo && wallRef && wallRef.photo}}" bindtap="goWall">
    <view class="between"><text class="small">墙面位置：{{wallRef.wallName}}</text><text class="faint">›</text></view>
  </view>

  <!-- Beta -->
  <view class="section-title">
    Beta ({{betas.length}})
    <view class="row">
      <view class="hfilter {{onlyMyHeight ? 'on' : ''}}" wx:if="{{hasHeight}}" bindtap="toggleHeightFilter">适合我身高</view>
      <text class="section-more" bindtap="goPublish">＋ 发我的Beta</text>
    </view>
  </view>
  <beta-card wx:for="{{shownBetas}}" wx:key="id" beta="{{item}}" showRoute="{{false}}" />
  <empty-state
    wx:if="{{!shownBetas.length}}"
    title="{{onlyMyHeight ? '暂无匹配你身高的 Beta' : '还没有人分享 Beta'}}"
    desc="{{onlyMyHeight ? '关掉筛选看看全部' : '第一条 Beta 由你来写？'}}"
    btnText="发布 Beta"
    bind:action="goPublish"
  />

  <!-- 最近打卡 -->
  <view class="section-title" wx:if="{{checkins.length}}">最近打卡</view>
  <view class="card ck" wx:for="{{checkins}}" wx:key="id">
    <view class="row">
      <view class="avatar-emoji ck-avatar" style="background:{{item.user.color}}" data-id="{{item.user.id}}" bindtap="goUser">{{item.user.emoji}}</view>
      <view class="flex-1">
        <text class="bold small">{{item.user.nickname}}</text>
        <text class="small muted"> {{item.resultText}}</text>
        <text class="small faint" wx:if="{{item.result !== 'flash'}}"> · {{item.attempts}} 次尝试</text>
      </view>
      <text class="small faint">{{item.dateText}}</text>
    </view>
  </view>

  <view class="safety small faint">攀岩有风险，Beta 仅供参考，请量力而行并注意落点保护</view>
</view>
