.main {
  padding: 28rpx;
}
.hero-photo {
  width: 100%;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  background: #f0f2f5;
  display: block;
}
.hero-wall {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  background: #16181f;
}
.hero-wall-img {
  width: 100%;
  display: block;
}
.hero-dot {
  position: absolute;
  transform: translate(-50%, -50%);
  min-width: 56rpx;
  height: 56rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  border: 4rpx solid #ffde59;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 10rpx rgba(255, 222, 89, 0.25);
}
.hero-dot-t {
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
}
.hero-dot.light .hero-dot-t {
  color: #33363d;
}
.hero-wall-tip {
  position: absolute;
  right: 20rpx;
  bottom: 16rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}
.main-meta {
  margin-top: 6rpx;
}
.rd-missing {
  padding: 60rpx 32rpx;
  text-align: center;
}
.rd-missing-desc {
  margin-top: 10rpx;
}
.rd-missing-btn {
  margin-top: 28rpx;
}
.edit-links {
  gap: 32rpx;
  margin-top: 10rpx;
}
.edit-link {
  color: #ff6b35;
  font-weight: 600;
}
.del-link {
  color: #e5484d;
}
.feel-line {
  margin-top: 10rpx;
}
.add-photo {
  margin-top: 20rpx;
}
.big-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.big-dot.light {
  border: 2rpx solid #d5d8de;
}
.main-info {
  margin: 0 16rpx;
}
.main-name {
  font-size: 36rpx;
  font-weight: 800;
  margin-right: 12rpx;
}
.main-grade {
  min-width: 88rpx;
  font-size: 30rpx;
  padding: 6rpx 18rpx;
}
.main-tags {
  margin-top: 20rpx;
}
.main-stats {
  margin-top: 8rpx;
}
.warn {
  color: #e5484d;
  font-weight: 600;
}

.feel {
  margin-top: 24rpx;
}
.feel-bar {
  display: flex;
  height: 16rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #f0f2f5;
}
.feel-soft { background: #30a46c; }
.feel-fair { background: #ffb224; }
.feel-hard { background: #e5484d; }
.feel-legend {
  margin-top: 8rpx;
}
.feel-vote {
  margin-top: 20rpx;
}
.vote-label {
  margin-right: 8rpx;
}
.vote-chip {
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  background: #f0f2f5;
  color: #5a6072;
  font-size: 22rpx;
  margin-right: 12rpx;
}
.vote-chip.on {
  background: #1b1e28;
  color: #fff;
  font-weight: 700;
}

.actions {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.act-main {
  flex: 1;
  margin-right: 16rpx;
  white-space: nowrap;
}
.act-side {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-left: 4rpx;
  margin-right: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(27, 30, 40, 0.05);
}
.act-side.on {
  background: #fff1ea;
}
/* 原生 button 默认样式全量覆盖，锁成圆形图标按钮 */
.share-btn {
  width: 88rpx !important;
  height: 88rpx;
  min-height: 0;
  box-sizing: border-box;
  padding: 0;
  margin: 0 0 0 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: normal;
  border: none;
  border-radius: 50%;
  background: #ffffff;
}
.share-btn::after {
  border: none;
}

.hero-ring {
  position: absolute;
  transform: translate(-50%, -50%);
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 6rpx solid;
  box-shadow: 0 0 8rpx rgba(0, 0, 0, 0.35), inset 0 0 8rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
}
.hero-num {
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 800;
  text-shadow: 0 0 6rpx rgba(0, 0, 0, 0.9);
}
.ai-sub {
  margin-top: 20rpx;
  color: #7a4de8;
}
.ai {
  background: #fbfaff;
  border: 2rpx solid #ece6fb;
}
.ai-tip {
  color: #5a6072;
  margin-top: 12rpx;
  line-height: 1.6;
}
.ai-deep {
  margin-top: 24rpx;
  font-size: 26rpx;
  padding: 16rpx 0;
  background: #f1ecfd;
  color: #6b3fd6;
}
.ai-again {
  margin-top: 20rpx;
  color: #7a4de8;
  text-align: right;
}
.wall-link {
  padding: 22rpx 24rpx;
  font-size: 26rpx;
}
.hfilter {
  font-size: 22rpx;
  color: #5a6072;
  background: #ffffff;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  margin-right: 16rpx;
  font-weight: 400;
}
.hfilter.on {
  background: #fff1ea;
  color: #e8571f;
  font-weight: 700;
}

.ck {
  padding: 18rpx 24rpx;
  margin-bottom: 14rpx;
}
.ck-avatar {
  width: 56rpx;
  height: 56rpx;
  font-size: 30rpx;
  margin-right: 14rpx;
}

.safety {
  text-align: center;
  padding: 32rpx 0 48rpx;
}

/* 换线维护 */
.removed-banner {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 24rpx;
}
.report-link {
  text-align: center;
  padding: 4rpx 0 8rpx;
}
